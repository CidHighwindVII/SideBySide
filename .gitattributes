# Enforce LF for all text files
* text eol=lf

# Binary safety: `* text eol=lf` above CRLF-collapses any binary containing
# 0D 0A (PNG signatures, CRCs, ICO entries) and corrupts it on add/checkout.
# Marked binary so git never newline-touches these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.jar binary
*.aar binary
*.zip binary
*.apk binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
